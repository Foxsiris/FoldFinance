    <string name="settings_currency_gbp">Фунт стерлингов</string>

    <!-- Безопасность -->
    <string name="settings_lock_title">Блокировка приложения</string>
    <string name="settings_lock_body">Отпечаток пальца или PIN-код телефона при запуске и после перерыва.</string>
    <string name="settings_lock_unprotected">На телефоне не настроены PIN-код или отпечаток, поэтому блокировка не работает: приложение откроется без проверки.</string>
    <string name="settings_lock_unavailable">Сейчас телефон не может проверить отпечаток или PIN-код. Блокировка не сработает, пока проверка недоступна.</string>
    <string name="settings_lock_open_settings">Настроить блокировку экрана</string>
    <string name="settings_timeout_title">Блокировать снова</string>
    <string name="settings_timeout_immediately">Сразу после выхода</string>
    <string name="settings_timeout_1">Через 1 минуту</string>
    <string name="settings_timeout_5">Через 5 минут</string>
    <string name="settings_timeout_15">Через 15 минут</string>
    <string name="settings_timeout_short_immediately">сразу</string>
