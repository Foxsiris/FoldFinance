<?xml version="1.0" encoding="utf-8"?>
<!--
  Статичное превью виджета «На проверку» 2×2 (android:previewLayout); см. widget_preview_finance.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_review_title"
        android:textColor="#FFA1A1A8"
        android:textSize="12.5sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_preview_review_count"
        android:textColor="#FFFFB547"
        android:textSize="48sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:text="@string/widget_preview_review_waiting"
        android:textColor="#FF8A8A92"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/widget_preview_outline_bg"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/widget_review_action"
        android:textColor="#FFFFB547"
        android:textSize="14sp" />
</LinearLayout>
